# --- LLM provider (OpenAI-compatible; point at Ollama / LM Studio / llama.cpp) ---
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=local-no-key-needed
OPENAI_MODEL=qwen2.5

# --- Optional: Gemini provider (opt-in; cloud). Key is read from env only. ---
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash

# --- Which provider the agent uses by default (openai | gemini). Default: openai. ---
# HARNESS_PROVIDER=openai

# --- Local embeddings (optional; the memory seam reads this) ---
EMBEDDING_MODEL=nomic-embed-text

# --- Local storage ---
SQLITE_DB_PATH=./harness.db
